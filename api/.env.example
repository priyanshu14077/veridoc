# Copy to api/.env. Names only; no real values belong in the repo.
DATABASE_URL=postgresql+psycopg://crosscheck:crosscheck@localhost:5433/crosscheck
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
TRUST_PROXY=true
SEED_DEMO_PASSWORD=crosscheck-demo

# Extraction (get a key at aistudio.google.com; never commit it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=["gemini-3.8-flash","gemini-flash-latest"]
GEMINI_RPM=8
CONFIDENCE_THRESHOLD=0.85
STORAGE_DIR=storage
MAX_UPLOAD_MB=15
