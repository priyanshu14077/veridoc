# Copy to deploy/.env on the server and fill in. Names only here; never commit real values.

# The public address. With no domain, use the server's IP via sslip.io: 13-233-10-20.sslip.io
SITE_ADDRESS=
# Long random string: openssl rand -hex 24  (hex, so it's safe inside the database URL)
POSTGRES_PASSWORD=

# Gemini free tier: synthetic sample documents only (TDD A11)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RPM=8

SEED_DEMO_PASSWORD=veridoc-demo
SESSION_TTL_HOURS=12
CONFIDENCE_THRESHOLD=0.85
MAX_UPLOAD_MB=15

# Observability (Grafana at https://SITE_ADDRESS/grafana, user "admin").
# deploy/deploy.sh creates GRAFANA_ADMIN_PASSWORD on the server if it's missing.
GRAFANA_ADMIN_PASSWORD=
# Alert email: Gmail address + a Gmail app password (Google account → Security → App passwords).
SMTP_ENABLED=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
