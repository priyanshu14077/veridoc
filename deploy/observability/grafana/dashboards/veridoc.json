{
 "uid": "veridoc-overview",
 "title": "Veridoc overview",
 "tags": [
  "veridoc"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Is it up and fast? (API, via Caddy)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Requests / min",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"veridoc-api\"}[5m])) * 60",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   }
  },
  {
   "type": "stat",
   "title": "5xx share (15 min)",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"veridoc-api\",http_response_status_code=~\"5..\"}[15m])) / sum(rate(http_server_request_duration_seconds_count{service_name=\"veridoc-api\"}[15m])) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   }
  },
