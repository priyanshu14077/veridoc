   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max(veridoc_jobs_oldest_age_seconds{status=\"queued\"}) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
