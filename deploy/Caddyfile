# One address for everything, so the session cookie is first-party and there's no CORS.
#   /            the landing page (static files baked into this image at /srv/landing)
#   /api/*       the API
#   everything else (/login, /shipments, /_next/*, ...) the web app
# Caddy gets and renews the HTTPS certificate for SITE_ADDRESS on its own.
{$SITE_ADDRESS} {
	encode zstd gzip

	# One JSON line per request (status, duration). Cookies and auth headers are redacted by
	# Caddy itself.
	log {
		output stdout
		format json
	}
	# Extra directives, only when the local monitoring overlay mounts them (request tracing).
	# In production nothing matches, and Caddy skips the import.
	import /etc/caddy/local.d/*.caddy

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API checks the 15 MB limit itself; this only stops absurd bodies early.
	request_body /api/* {
		max_size 20MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# ── Landing page ──
	# Its JS, CSS and fonts are built under /_landing (the app owns /_next). File names carry a
	# content hash, so they can be cached for a year and never revalidated.
	handle_path /_landing/* {
		root * /srv/landing
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Background photos and video: not hashed, so a week, then revalidate (ETag).
	handle /media/* {
		root * /srv/landing
		header Cache-Control "public, max-age=604800"
		file_server
	}
	# The page itself: always revalidate, so a deploy shows up at once.
	@landing path / /index.html /icon.svg
	handle @landing {
		root * /srv/landing
		header Cache-Control "no-cache"
		file_server
	}

	# ── The app ──
	handle {
		reverse_proxy web:3000
	}
}
