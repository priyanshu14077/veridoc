# One address for everything, so the session cookie is first-party and there's no CORS.
# Caddy gets and renews the HTTPS certificate for SITE_ADDRESS on its own.
{$SITE_ADDRESS} {
	encode zstd gzip

	# One JSON line per request (status, duration, trace id). Cookies and auth headers are
	# redacted by Caddy itself. The collector ships these to VictoriaLogs.
	log {
		output stdout
		format json
	}
	# Start a trace for every request and pass it on, so API and web spans join it.
	tracing {
		span http.request
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API checks the 15 MB limit itself; this only stops absurd bodies early.
	request_body /api/* {
		max_size 20MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	# Dashboards and alerts. Grafana has its own login (admin password in deploy/.env).
	handle /grafana* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy web:3000
	}
}
